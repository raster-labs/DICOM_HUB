# Release & Image Version Configuration
APP_VERSION=v1.0.0
HTTP_PORT=80
BACKEND_PORT=8080
POSTGRES_PORT=5432

# PostgreSQL Operational Database
POSTGRES_DB=dicomhub
POSTGRES_USER=dicomhub
POSTGRES_PASSWORD=dicomhub_secret

# Default Hospital Site Tenant ID (Kauvery Chennai Flagship)
HUB_DEFAULT_SITE_ID=11111111-1111-1111-1111-111111111111

# DICOM Storage SCP Endpoint
HUB_ROLE=all
HUB_DICOM_SCP_ENABLED=true
HUB_DICOM_AE_TITLE=DICOMHUB_AE
HUB_DICOM_BIND_HOST=0.0.0.0
HUB_DICOM_PORT=11112

# Storage Root (Segregated into original-repo/, working-copies/, ai-results/)
HUB_STORAGE_ROOT=./storage

# 32-Byte Base64-Encoded AES-256-GCM Master Key for On-Premise Pseudonym Vault
# Automatically generated by ./scripts/deploy.sh or generate manually via: openssl rand -base64 32
HUB_PSEUDONYM_AES_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
